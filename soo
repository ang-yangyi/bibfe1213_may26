<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Kajang History</title>
	<style>
		:root {
			--bg: #f4f8fb;
			--surface: #ffffff;
			--primary: #0f4c81;
			--accent: #ff9f1c;
			--text: #1e2a33;
			--muted: #5b6b75;
			--border: #d6e1ea;
		}

		* {
			box-sizing: border-box;
		}

		body {
			margin: 0;
			font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
			color: var(--text);
			background: linear-gradient(180deg, #eef5fb 0%, #f9fcff 45%, #ffffff 100%);
			line-height: 1.6;
		}

		.container {
			width: min(960px, 92%);
			margin: 0 auto;
			padding: 28px 0 52px;
		}

		.hero {
			background: var(--surface);
			border: 1px solid var(--border);
			border-radius: 16px;
			padding: 30px;
			box-shadow: 0 10px 30px rgba(15, 76, 129, 0.08);
		}

		.badge {
			display: inline-block;
			background: rgba(15, 76, 129, 0.1);
			color: var(--primary);
			border: 1px solid rgba(15, 76, 129, 0.2);
			border-radius: 999px;
			padding: 6px 12px;
			font-size: 0.85rem;
			font-weight: 600;
			letter-spacing: 0.3px;
		}

		h1 {
			margin: 14px 0 10px;
			font-size: clamp(1.8rem, 3.5vw, 2.6rem);
			line-height: 1.2;
			color: var(--primary);
		}

		.subtitle {
			margin: 0;
			color: var(--muted);
			font-size: 1.05rem;
		}

		.section-title {
			margin: 34px 0 14px;
			font-size: 1.35rem;
			color: #113a5f;
		}

		.grid {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
			gap: 14px;
		}

		.card {
			background: var(--surface);
			border: 1px solid var(--border);
			border-radius: 12px;
			padding: 18px;
			box-shadow: 0 6px 18px rgba(15, 76, 129, 0.05);
		}

		.card h3 {
			margin: 0 0 8px;
			color: #1a3d5d;
			font-size: 1.05rem;
		}

		.card p {
			margin: 0;
			color: var(--muted);
			font-size: 0.95rem;
		}

		.highlight {
			margin-top: 24px;
			background: #fff8ed;
			border-left: 5px solid var(--accent);
			border-radius: 10px;
			padding: 14px 16px;
			color: #5d420e;
		}

		footer {
			margin-top: 28px;
			color: var(--muted);
			font-size: 0.9rem;
			text-align: center;
		}

		.back-link {
			display: inline-block;
			margin-top: 20px;
			color: var(--primary);
			text-decoration: none;
			font-weight: 500;
		}

		.back-link:hover {
			text-decoration: underline;
		}
	</style>
</head>
<body>
	<main class="container">
		<section class="hero">
			<span class="badge">Kajang History</span>
			<h1>History of Kajang</h1>
			<p class="subtitle">
				Discover the rich history of Kajang, a town with a vibrant past and modern present.
			</p>
		</section>

		<h2 class="section-title">Key Historical Events</h2>
		<section class="card" id="kajang-history-container">
			<div id="kajang-history-list"></div>
		</section>

		<a href="index.html" class="back-link">&larr; Back to Home</a>

		<footer>
			Kajang history page prepared for BIBFE1213 &middot; Introduction to Generative AI Tools
		</footer>
	</main>

	<script>
		const kajangHistory = [
			{ year: "1800s", event: "Kajang was founded as a tin-mining town in the 19th century." },
			{ year: "1890s", event: "The town developed rapidly with the growth of the tin mining industry." },
			{ year: "1900s", event: "Kajang became a major agricultural hub for rubber and palm oil." },
			{ year: "1957", event: "Malaya gained independence, and Kajang continued to grow as a suburban town." },
			{ year: "1990s-present", event: "Kajang transformed into a modern town with rapid development and improved infrastructure." }
		];

		function showKajangHistory() {
			const historyList = document.getElementById('kajang-history-list');
			historyList.innerHTML = '';
			
			kajangHistory.forEach(item => {
				const historyItem = document.createElement('div');
				historyItem.style.borderLeft = '3px solid var(--primary)';
				historyItem.style.paddingLeft = '12px';
				historyItem.style.marginBottom = '12px';
				
				const yearElement = document.createElement('strong');
				yearElement.textContent = item.year;
				yearElement.style.color = 'var(--primary)';
				
				const eventElement = document.createElement('p');
				eventElement.textContent = item.event;
				eventElement.style.margin = '4px 0 0 0';
				eventElement.style.color = 'var(--text)';
				
				historyItem.appendChild(yearElement);
				historyItem.appendChild(eventElement);
				historyList.appendChild(historyItem);
			});
		}

		showKajangHistory();
	</script>
</body>
</html>
